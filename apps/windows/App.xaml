<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared settings layout. Values follow the WinUI Gallery
                 settings sample: 36 px page inset, a 1064 px content column,
                 30/6 header spacing and 4 px between cards. -->
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="SettingsContentMaxWidth">1064</x:Double>
            <Thickness x:Key="SettingsContentPadding">36,0,36,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
