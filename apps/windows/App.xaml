<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Fluent color tokens copied from the WinUI 3 source theme
                 dictionaries (.refs, Common_themeresources_any.xaml). The
                 runtime in this environment crashes with 0xC000027B when app
                 XAML resolves these keys from the framework, so the values are
                 replicated here under their official names and every local
                 lookup stays in this dictionary. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#4D4D4D" />
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#E62B2B2B" />
                    <SolidColorBrush x:Key="FloatingPanelStrokeBrush" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelPrimaryTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelSecondaryTextBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1A1A1A" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="#B31C1C1C" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726" />
                    <!-- AccentFillColorDefault equals SystemAccentColorLight2;
                         this is the stock Windows accent, used when the system
                         accent is the default blue. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828" />
                    <!-- Button state fills from Common_themeresources_any:
                         subtle hover/press and a dimmed disabled state, so the
                         default Button template matches AppBarButton metrics. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5DFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#000000" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelStrokeBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="FloatingPanelPrimaryTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="FloatingPanelSecondaryTextBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#F5F5F5" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="#C9FFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9" />
                    <!-- AccentFillColorDefault equals SystemAccentColorDark1;
                         this is the stock Windows accent, used when the system
                         accent is the default blue. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9" />
                    <!-- Button state fills from Common_themeresources_any:
                         subtle hover/press and a dimmed disabled state, so the
                         default Button template matches AppBarButton metrics. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#09000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#06000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9E000000" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Flyout surface from the official MenuFlyout presenter style:
                 8 px overlay radius, 1 px flyout stroke, 0,2 inner padding.
                 The default presenter in this runtime ignores those values, so
                 they are restated here without a template. -->
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0,2,0,2" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="MinHeight" Value="32" />
            </Style>

            <!-- Menu item template copied from the official menu flyout theme
                 resources. The default template in this runtime leaves the
                 shortcut text left aligned inside the reserved box, so the
                 shortcuts only line up on their left edge. Restating the
                 template with right aligned shortcut text keeps every shortcut
                 flush with the menu's right padding on every open. -->
            <Style TargetType="MenuFlyoutItem">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="11,8,11,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutItem">
                            <Grid x:Name="LayoutRoot"
                                  Padding="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckPlaceholderStates">
                                        <VisualState x:Name="NoPlaceholder" />
                                        <VisualState x:Name="CheckPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="28,0,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IconPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="28,0,0,0" />
                                                <Setter Target="IconRoot.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckAndIconPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="56,0,0,0" />
                                                <Setter Target="IconRoot.Visibility" Value="Visible" />
                                                <Setter Target="IconRoot.Margin" Value="28,0,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PaddingSizeStates">
                                        <VisualState x:Name="DefaultPadding" />
                                        <VisualState x:Name="NarrowPadding">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Padding" Value="11,4,11,7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
                                        <VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
                                        <VisualState x:Name="KeyboardAcceleratorTextVisible">
                                            <VisualState.Setters>
                                                <Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox x:Name="IconRoot"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Width="16" Height="16" Visibility="Collapsed">
                                    <ContentPresenter x:Name="IconContent"
                                                      Content="{TemplateBinding Icon}"
                                                      Foreground="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <TextBlock x:Name="TextBlock"
                                           Text="{TemplateBinding Text}"
                                           TextTrimming="Clip"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <TextBlock x:Name="KeyboardAcceleratorTextBlock"
                                           Grid.Column="1"
                                           Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KeyboardAcceleratorTextMinWidth}"
                                           Margin="24,0,0,0"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Visibility="Collapsed"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
