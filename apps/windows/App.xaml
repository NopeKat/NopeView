<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/SettingsCardOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Fluent color tokens pinned from the official WinUI theme
                 dictionaries (.refs, Common_themeresources_any.xaml). Only the
                 keys the caption, viewer and settings surface read directly are
                 restated here, so their values stay stable even when a system
                 theme update reorders the framework dictionaries. Everything
                 else comes from XamlControlsResources above. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CaptionGlyphInactiveBrush" Color="#808080" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#4D4D4D" />
                    <!-- Close button danger colors. The native close button does
                         not follow the accent color, so these stay fixed per
                         theme instead of deriving from SystemAccentColor. -->

                    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
                    <SolidColorBrush x:Key="CaptionCloseHoverGlyphBrush" Color="#FCE1E3" />
                    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="CaptionClosePressedGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#E62B2B2B" />
                    <SolidColorBrush x:Key="FloatingPanelStrokeBrush" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelPrimaryTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelSecondaryTextBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1A1A1A" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="#B31C1C1C" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#442726" />
                    <!-- AccentFillColorDefault equals SystemAccentColorLight2;
                         this is the stock Windows accent, used when the system
                         accent is the default blue. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#282828" />
                    <!-- Button state fills from Common_themeresources_any:
                         subtle hover/press and a dimmed disabled state, so the
                         default Button template matches AppBarButton metrics. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5DFFFFFF" />

                    <!-- Tokens used by the CommunityToolkit SettingsCard
                         templates. They stay local so the card surface keeps the
                         values the toolkit expects on every theme. -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" />
                    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />
                    <StaticResource x:Key="SystemControlDescriptionTextForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <Color x:Key="CardStrokeColorDefault">#19000000</Color>
                    <StaticResource x:Key="ControlStrongFillColorDefaultBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SolidBackgroundFillColorTransparent" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemColorGrayTextColorBrush" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="SystemColorWindowColorBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemColorWindowTextColorBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlBackgroundBaseMediumBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlBackgroundTransparentRevealBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightAltTransparentRevealBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListLowRevealBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListMediumRevealBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemControlTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlTransparentRevealBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="SystemColorButtonFaceColorBrush" Color="#282828" />
                    <SolidColorBrush x:Key="SystemColorButtonTextColorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemColorHighlightColorBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="SystemColorHighlightTextColorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="SystemControlDisabledTransparentBrush" Color="#00FFFFFF" />

                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#000000" />
                    <SolidColorBrush x:Key="CaptionGlyphInactiveBrush" Color="#999999" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#CCCCCC" />

                    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E81123" />
                    <SolidColorBrush x:Key="CaptionCloseHoverGlyphBrush" Color="#FCE1E3" />
                    <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="CaptionClosePressedGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelBrush" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="FloatingPanelStrokeBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="FloatingPanelPrimaryTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="FloatingPanelSecondaryTextBrush" Color="#5D5D5D" />
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#F5F5F5" />

                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ControlOnImageFillColorDefaultBrush" Color="#C9FFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FDE7E9" />
                    <!-- AccentFillColorDefault equals SystemAccentColorDark1;
                         this is the stock Windows accent, used when the system
                         accent is the default blue. -->
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#F9F9F9" />
                    <!-- Button state fills from Common_themeresources_any:
                         subtle hover/press and a dimmed disabled state, so the
                         default Button template matches AppBarButton metrics. -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#09000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#06000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9E000000" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C000000" />

                    <!-- Toolkit tokens; see the Dark dictionary. -->
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FFFFFF" />
                    <StaticResource x:Key="SystemControlDescriptionTextForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <Color x:Key="CardStrokeColorDefault">#19000000</Color>
                    <StaticResource x:Key="ControlStrongFillColorDefaultBrush" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="LayerOnMicaBaseAltFillColorTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SolidBackgroundFillColorTransparent" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemColorGrayTextColorBrush" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="SystemColorWindowColorBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemColorWindowTextColorBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlBackgroundBaseMediumBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlBackgroundTransparentRevealBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightAltTransparentRevealBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListLowRevealBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemControlHighlightListMediumRevealBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="SystemControlTransparentBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="SystemControlTransparentRevealBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SystemColorButtonFaceColorBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="SystemColorButtonTextColorBrush" Color="#000000" />
                    <SolidColorBrush x:Key="SystemColorHighlightColorBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="SystemColorHighlightTextColorBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#09000000" />
                    <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="SystemControlDisabledTransparentBrush" Color="#00FFFFFF" />

                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Non-color tokens referenced by the toolkit SettingsCard
                 templates, pinned so the card metrics do not follow a
                 framework change silently. -->
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <x:Double x:Key="SettingsCardDescriptionFontSize">12</x:Double>
            <x:String x:Key="ControlFasterAnimationDuration">00:00:00.083</x:String>
            <x:String x:Key="ControlNormalAnimationDuration">00:00:00.250</x:String>
            <Thickness x:Key="SettingsCardBorderThickness">1</Thickness>
            <Thickness x:Key="SettingsExpanderItemBorderThickness">1,0,0,0</Thickness>
            <Thickness x:Key="ExpanderChevronBorderThickness">1</Thickness>
            <Thickness x:Key="ExpanderHeaderBorderThickness">1</Thickness>
            <Thickness x:Key="ExpanderContentDownBorderThickness">1,0,1,1</Thickness>
            <Thickness x:Key="ExpanderContentUpBorderThickness">1,1,1,0</Thickness>
            <Thickness x:Key="ToggleSwitchOnStrokeThickness">1</Thickness>
            <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">1</Thickness>

            <!-- Lightweight styling values from the toolkit SettingsCard
                 template. Without local copies the content column collapses. -->
            <Thickness x:Key="SettingsCardPadding">16</Thickness>
            <x:Double x:Key="SettingsCardMinWidth">148</x:Double>
            <x:Double x:Key="SettingsCardMinHeight">68</x:Double>
            <x:Double x:Key="SettingsCardHeaderIconMaxSize">20</x:Double>
            <x:Double x:Key="SettingsCardLeftIndention">0</x:Double>
            <x:Double x:Key="SettingsCardContentMinWidth">120</x:Double>
            <x:Double x:Key="SettingsCardActionIconMaxSize">13</x:Double>
            <x:Double x:Key="SettingsCardVerticalHeaderContentSpacing">8</x:Double>
            <x:Double x:Key="SettingsCardWrapThreshold">476</x:Double>
            <x:Double x:Key="SettingsCardWrapNoIconThreshold">286</x:Double>
            <Thickness x:Key="SettingsCardHeaderIconMargin">2,0,20,0</Thickness>
            <Thickness x:Key="SettingsCardActionIconMargin">14,0,0,0</Thickness>



            <!-- Flyout surface from the official MenuFlyout presenter style:
                 acrylic backdrop, 8 px overlay radius, 1 px flyout stroke,
                 0,2 inner padding. The official content-driven minimum width
                 makes the first open narrower than later ones because the
                 shortcut column is measured late, so a fixed 280 px minimum
                 keeps every open the same width. -->
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="SystemBackdrop">
                    <Setter.Value>
                        <DesktopAcrylicBackdrop />
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0,2,0,2" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="MinHeight" Value="32" />
            </Style>

            <!-- Menu item template copied from the official menu flyout theme
                 resources. The default template in this runtime leaves the
                 shortcut text left aligned inside the reserved box, so the
                 shortcuts only line up on their left edge. Restating the
                 template with right aligned shortcut text keeps every shortcut
                 flush with the menu's right padding on every open. The 4 px
                 root margin is the official MenuFlyoutItemMargin, which keeps
                 the hover highlight inset from the acrylic edge. -->
            <Style TargetType="MenuFlyoutItem">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="11,8,11,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutItem">
                            <Grid x:Name="LayoutRoot"
                                  Padding="{TemplateBinding Padding}"
                                  Margin="4,2,4,2"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="IconContent.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckPlaceholderStates">
                                        <VisualState x:Name="NoPlaceholder" />
                                        <VisualState x:Name="CheckPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="28,0,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IconPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="28,0,0,0" />
                                                <Setter Target="IconRoot.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckAndIconPlaceholder">
                                            <VisualState.Setters>
                                                <Setter Target="TextBlock.Margin" Value="56,0,0,0" />
                                                <Setter Target="IconRoot.Visibility" Value="Visible" />
                                                <Setter Target="IconRoot.Margin" Value="28,0,0,0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PaddingSizeStates">
                                        <VisualState x:Name="DefaultPadding" />
                                        <VisualState x:Name="NarrowPadding">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Padding" Value="11,4,11,5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
                                        <VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
                                        <VisualState x:Name="KeyboardAcceleratorTextVisible">
                                            <VisualState.Setters>
                                                <Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox x:Name="IconRoot"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Width="16" Height="16" Visibility="Collapsed">
                                    <ContentPresenter x:Name="IconContent"
                                                      Content="{TemplateBinding Icon}"
                                                      Foreground="{TemplateBinding Foreground}" />
                                </Viewbox>
                                <TextBlock x:Name="TextBlock"
                                           Text="{TemplateBinding Text}"
                                           TextTrimming="Clip"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <TextBlock x:Name="KeyboardAcceleratorTextBlock"
                                           Grid.Column="1"
                                           Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           MinWidth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KeyboardAcceleratorTextMinWidth}"
                                           Margin="24,4,0,0"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Visibility="Collapsed"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
