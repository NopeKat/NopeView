<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/SettingsCardOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The viewer paints its own canvas behind the image, so this is
                 the only surface token the app owns. Everything else resolves
                 from the official WinUI theme dictionaries. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1A1A1A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#F5F5F5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
