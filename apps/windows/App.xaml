            <Thickness x:Key="ToggleSwitchOnStrokeThickness">1</Thickness>
            <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">1</Thickness>

            <!-- Lightweight styling values from the toolkit SettingsCard
                 template. Without local copies the content column collapses. -->
            <Thickness x:Key="SettingsCardPadding">16</Thickness>
            <x:Double x:Key="SettingsCardMinWidth">148</x:Double>
            <x:Double x:Key="SettingsCardMinHeight">68</x:Double>
