<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CloseGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#4D4D4D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#000000" />
                    <SolidColorBrush x:Key="CloseGlyphBrush" Color="#000000" />
                    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#CCCCCC" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
