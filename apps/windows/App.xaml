<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared settings layout. Values follow the Windows settings
                 page: 24 px page inset, a 1000 px content column and 4 px
                 between cards. -->
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="SettingsContentMaxWidth">1000</x:Double>
            <Thickness x:Key="SettingsContentPadding">24,0,24,24</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
