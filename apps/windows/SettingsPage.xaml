<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NopeView.App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="SettingsPage"
    AutomationProperties.Name="Settings"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
        <Style x:Key="SettingsNavButtonStyle" TargetType="local:SettingsNavItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="4,2,4,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <!-- A two-pane settings shell: the real NavigationView control needs
         framework style keys this runtime cannot resolve, so the same Fluent
         hierarchy is built from nav items and panels. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <StackPanel Margin="0,4,0,0">
                <Grid>
                    <local:SettingsNavItem x:Name="AppearanceNavButton"
                                           Style="{StaticResource SettingsNavButtonStyle}"
                                           Tag="Appearance"
                                           AutomationProperties.Name="Appearance"
                                           AutomationProperties.AutomationId="AppearanceNavItem"
                                           Click="SettingsNavButton_Click"
                                           KeyDown="SettingsNavItem_KeyDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                      Data="M 3.5,1 A 0.5,0.5,0,0,0,3,1.5 L 3,9 A 2,2,0,0,0,5,11 L 6,11 L 6,13 A 2,2,0,1,0,10,13 L 10,11 L 11,11 A 2,2,0,0,0,13,9 L 13,1.5 A 0.5,0.5,0,0,0,12.5,1 Z M 4,7 L 4,2 L 8,2 L 8,3.5 A 0.5,0.5,0,0,0,9,3.5 L 9,2 L 10,2 L 10,4.5 A 0.5,0.5,0,0,0,11,4.5 L 11,2 L 12,2 L 12,7 Z M 4,8 L 12,8 L 12,9 A 1,1,0,0,1,11,10 L 9.5,10 A 0.5,0.5,0,0,0,9,10.5 L 9,13 A 1,1,0,1,1,7,13 L 7,10.5 A 0.5,0.5,0,0,0,6.5,10 L 5,10 A 1,1,0,0,1,4,9 Z" />
                            <TextBlock Grid.Column="1"
                                       Text="Appearance"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </local:SettingsNavItem>
                    <Rectangle x:Name="AppearanceNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False" />
                </Grid>
                <Grid>
                    <local:SettingsNavItem x:Name="AboutNavButton"
                                           Style="{StaticResource SettingsNavButtonStyle}"
                                           Tag="About"
                                           AutomationProperties.Name="About"
                                           AutomationProperties.AutomationId="AboutNavItem"
                                           Click="SettingsNavButton_Click"
                                           KeyDown="SettingsNavItem_KeyDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                      Data="M 8.499,7.5 A 0.5,0.5,0,1,0,7.499,7.5 L 7.499,10.5 A 0.5,0.5,0,0,0,8.499,10.5 Z M 8.749,5.5 A 0.749,0.749,0,1,1,7.25,5.5 A 0.749,0.749,0,0,1,8.748,5.5 M 8,1 A 7,7,0,1,0,8,15 A 7,7,0,0,0,8,1 M 2,8 A 6,6,0,1,1,14,8 A 6,6,0,0,1,2,8" />
                            <TextBlock Grid.Column="1"
                                       Text="About"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </local:SettingsNavItem>
                    <Rectangle x:Name="AboutNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Settings"
                       Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       Margin="36,24,36,0" />
            <ScrollViewer Grid.Row="1"
                          Padding="36,0,36,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="AppearancePanel" MaxWidth="1064"
                                Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}"
                                   Text="Appearance &amp; behavior" />
                        <toolkit:SettingsCard Description="Select which app theme to display"
                                              Header="App theme">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Width="20" Height="20"
                                          Data="M 10,2 A 8,8,0,0,1,13.388,17.249 A 3.77,3.77,0,0,1,10.097,17.19 C 9.123,16.687,8.401,15.723,8.449,14.459 C 8.466,14.014,8.531,13.592,8.592,13.216 C 8.655,12.829,8.71,12.504,8.728,12.201 C 8.746,11.904,8.724,11.668,8.65,11.469 C 8.58,11.278,8.45,11.088,8.2,10.9 C 7.887,10.665,7.62,10.625,7.355,10.663 C 7.055,10.706,6.741,10.851,6.341,11.05 C 5.606,11.415,4.565,11.992,3.367,11.382 C 2.265,10.82,1.943,9.514,2.147,8.465 A 8,8,0,0,1,10,2 M 10,3 A 7,7,0,0,0,3.129,8.655 C 2.976,9.443,3.255,10.202,3.82,10.49 C 4.504,10.838,5.071,10.564,5.896,10.154 C 6.276,9.966,6.73,9.742,7.214,9.673 C 7.734,9.598,8.268,9.701,8.8,10.1 C 9.19,10.392,9.445,10.734,9.588,11.121 C 9.728,11.5,9.75,11.889,9.728,12.261 C 9.706,12.627,9.638,13.014,9.579,13.377 A 9,9,0,0,0,9.449,14.497 C 9.417,15.309,9.867,15.945,10.557,16.302 A 2.77,2.77,0,0,0,12.964,16.344 A 7.002,7.002,0,0,0,10,3 M 12.5,13 A 1,1,0,1,1,12.5,15 A 1,1,0,0,1,12.5,13 M 14.5,10.5 A 1,1,0,1,1,14.5,12.5 A 1,1,0,0,1,14.5,10.5 M 14.5,7.5 A 1,1,0,1,1,14.5,9.5 A 1,1,0,0,1,14.5,7.5 M 12.5,5 A 1,1,0,1,1,12.5,7 A 1,1,0,0,1,12.5,5 M 9.5,4.5 A 1,1,0,1,1,9.5,6.5 A 1,1,0,0,1,9.5,4.5" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeComboBox"
                                      SelectedIndex="-1"
                                      AutomationProperties.AutomationId="ThemeComboBox"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Light" Tag="Light"
                                              AutomationProperties.AutomationId="ThemeLight" />
                                <ComboBoxItem Content="Dark" Tag="Dark"
                                              AutomationProperties.AutomationId="ThemeDark" />
                                <ComboBoxItem Content="Use system setting" Tag="System"
                                              AutomationProperties.AutomationId="ThemeSystem" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" MaxWidth="1064"
                                Spacing="{StaticResource SettingsCardSpacing}"
                                Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}"
                                   Text="About" />
                        <toolkit:SettingsCard Header="NopeView"
                                              Description="A fast, lightweight image viewer">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Width="20" Height="20"
                                          Data="M 14,7.5 A 1.5,1.5,0,1,1,11,7.5 A 1.5,1.5,0,0,1,14,7.5 M 13,7.5 A 0.5,0.5,0,1,0,12,7.5 A 0.5,0.5,0,0,0,13,7.5 M 3,6 A 3,3,0,0,1,6,3 L 14,3 A 3,3,0,0,1,17,6 L 17,14 A 3,3,0,0,1,14,17 L 6,17 A 3,3,0,0,1,3,14 Z M 6,4 A 2,2,0,0,0,4,6 L 4,14 C 4,14.373,4.102,14.722,4.28,15.02 L 8.949,10.432 A 1.5,1.5,0,0,1,11.051,10.432 L 15.721,15.02 A 2,2,0,0,0,16,14 L 16,6 A 2,2,0,0,0,14,4 Z M 6,16 L 14,16 C 14.37,16,14.715,15.9,15.012,15.726 L 10.35,11.146 A 0.5,0.5,0,0,0,9.65,11.146 L 4.988,15.726 A 2,2,0,0,0,6,16" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="VersionText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Repository"
                                              Description="Source code on GitHub">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Width="20" Height="20"
                                          Data="M 12.64,1.02 A 0.5,0.5,0,0,1,12.98,1.64 L 7.98,18.64 A 0.5,0.5,0,0,1,7.02,18.36 L 12.02,1.36 A 0.5,0.5,0,0,1,12.64,1.02 M 5.127,5.169 A 0.5,0.5,0,0,1,5.875,5.833 L 2.169,10 L 5.874,14.168 A 0.5,0.5,0,0,1,5.126,14.832 L 1.126,10.332 A 0.5,0.5,0,0,1,1.126,9.668 Z M 14.169,5.127 A 0.5,0.5,0,0,1,14.875,5.169 L 18.875,9.669 A 0.5,0.5,0,0,1,18.875,10.333 L 14.875,14.833 A 0.5,0.5,0,0,1,14.127,14.169 L 17.831,10 L 14.126,5.832 A 0.5,0.5,0,0,1,14.168,5.126" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <HyperlinkButton Content="NopeKat/NopeView"
                                             NavigateUri="https://github.com/NopeKat/NopeView" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
