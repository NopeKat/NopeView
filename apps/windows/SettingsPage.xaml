<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="SettingsPage"
    Background="Transparent">

    <!-- One settings page fills the window: the page header names the surface,
         section headers group the settings, and the about block closes the page
         instead of competing with appearance for a navigation slot. -->
    <Grid MaxWidth="{StaticResource SettingsPageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The back arrow and page title share one row, with the title to the
             right of the arrow. Both still start from the 36 px page inset. -->
        <Grid Margin="36,24,36,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.AutomationId="SettingsBackButton"
                    AutomationProperties.Name="Back"
                    ToolTipService.ToolTip="Back"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
            </Button>
            <TextBlock x:Name="SettingsHeader"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="SettingsPageHeader"
                       AutomationProperties.HeadingLevel="Level1" />
        </Grid>
        <ScrollView Grid.Row="1"
                    Padding="{StaticResource SettingsContentPadding}"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
            <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock x:Name="AppearanceSectionHeader"
                           Style="{StaticResource SettingsSectionHeaderStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <toolkit:SettingsCard x:Name="ThemeCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeComboBox"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="ThemeComboBox"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="ThemeSystemOption"
                                      Tag="System"
                                      AutomationProperties.AutomationId="ThemeSystem" />
                        <ComboBoxItem x:Name="ThemeLightOption"
                                      Tag="Light"
                                      AutomationProperties.AutomationId="ThemeLight" />
                        <ComboBoxItem x:Name="ThemeDarkOption"
                                      Tag="Dark"
                                      AutomationProperties.AutomationId="ThemeDark" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Name="ImageFrameCard"
                                      Margin="0,0,0,36">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B9;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ImageFrameComboBox"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="ImageFrameComboBox"
                              SelectionChanged="ImageFrameComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="ImageFrameNoneOption"
                                      Tag="None"
                                      AutomationProperties.AutomationId="ImageFrameNone" />
                        <ComboBoxItem x:Name="ImageFrameStrokeOption"
                                      Tag="Stroke"
                                      AutomationProperties.AutomationId="ImageFrameStroke" />
                        <ComboBoxItem x:Name="ImageFrameShadowOption"
                                      Tag="Shadow"
                                      AutomationProperties.AutomationId="ImageFrameShadow" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock x:Name="LanguageSectionHeader"
                           Style="{StaticResource SettingsSectionHeaderStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <toolkit:SettingsCard x:Name="LanguageCard"
                                      Margin="0,0,0,36">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LanguageComboBox"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="LanguageComboBox"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="LanguageSystemOption"
                                      Tag=""
                                      AutomationProperties.AutomationId="LanguageSystem" />
                        <ComboBoxItem x:Name="LanguageChineseOption"
                                      Tag="zh-Hans"
                                      AutomationProperties.AutomationId="LanguageChinese" />
                        <ComboBoxItem x:Name="LanguageEnglishOption"
                                      Tag="en-US"
                                      AutomationProperties.AutomationId="LanguageEnglish" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock x:Name="AboutSectionHeader"
                           Style="{StaticResource SettingsSectionHeaderStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <toolkit:SettingsExpander x:Name="AboutExpander"
                                          Margin="0,0,0,36"
                                          AutomationProperties.AutomationId="AboutExpander">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon Width="20"
                                    Height="20"
                                    ShowAsMonochrome="False"
                                    UriSource="ms-appx:///assets/nopeview-title.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="VersionText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="VersionText" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Name="RepositoryCard">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE71B;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <HyperlinkButton Content="NopeKat/NopeView"
                                             NavigateUri="https://github.com/NopeKat/NopeView" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
