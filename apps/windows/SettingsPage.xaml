<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="SettingsPage"
    AutomationProperties.Name="Settings"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="1,30,0,6" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="4,2,4,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <!-- A two-pane settings shell: the real NavigationView control needs
         framework style keys this runtime cannot resolve, so the same Fluent
         hierarchy is built from native Buttons and panels. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="0,24,0,0">
            <TextBlock Text="Settings"
                       Style="{StaticResource SettingsPageTitleStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       Margin="24,0,16,20" />
            <StackPanel Margin="0,56,0,0">
                <Grid>
                    <Button x:Name="AppearanceNavButton"
                            Style="{StaticResource SettingsNavButtonStyle}"
                            Tag="Appearance"
                            AutomationProperties.Name="Appearance"
                            AutomationProperties.AutomationId="AppearanceNavItem"
                            Click="SettingsNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                      Data="M 7.5,5.5 A 0.5,0.5,0,1,0,7.5,4.5 A 0.5,0.5,0,0,0,7.5,5.5 M 10,5.5 A 0.5,0.5,0,1,1,9,5.5 A 0.5,0.5,0,0,1,10,5.5 M 11.5,7 A 0.5,0.5,0,1,1,10.5,7 A 0.5,0.5,0,0,1,11.5,7 M 11,9.5 A 0.5,0.5,0,1,0,11,8.5 A 0.5,0.5,0,0,0,11,9.5 M 10.5,11 A 0.5,0.5,0,1,1,9.5,11 A 0.5,0.5,0,0,1,10.5,11 M 8,2 A 6,6,0,0,0,2,8 A 2,2,0,0,0,4,10 C 4.708,10,5.085,9.622,5.34,9.367 L 5.354,9.354 C 5.598,9.109,5.72,9,6,9 A 1,1,0,0,1,7,10 L 7,11 A 3,3,0,0,0,10,14 C 11.334,14,12.354,13.254,13.017,12.146 C 13.672,11.05,14,9.579,14,8 A 6,6,0,0,0,8,2 M 3,8 A 5,5,0,0,1,13,8 C 13,9.458,12.695,10.737,12.159,11.632 C 11.63,12.515,10.9,13,10,13 A 2,2,0,0,1,8,11 L 8,10 A 2,2,0,0,0,6,8 C 5.292,8,4.915,8.378,4.66,8.633 L 4.646,8.646 C 4.402,8.891,4.28,9,4,9 A 1,1,0,0,1,3,8" />
                            <TextBlock Grid.Column="1"
                                       Text="Appearance"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle x:Name="AppearanceNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False" />
                </Grid>
                <Grid>
                    <Button x:Name="AboutNavButton"
                            Style="{StaticResource SettingsNavButtonStyle}"
                            Tag="About"
                            AutomationProperties.Name="About"
                            AutomationProperties.AutomationId="AboutNavItem"
                            Click="SettingsNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="16" Height="16" VerticalAlignment="Center"
                                      Data="M 8.499,7.5 A 0.5,0.5,0,1,0,7.499,7.5 L 7.499,10.5 A 0.5,0.5,0,0,0,8.499,10.5 Z M 8.749,5.5 A 0.749,0.749,0,1,1,7.25,5.5 A 0.749,0.749,0,0,1,8.748,5.5 M 8,1 A 7,7,0,1,0,8,15 A 7,7,0,0,0,8,1 M 2,8 A 6,6,0,1,1,14,8 A 6,6,0,0,1,2,8" />
                            <TextBlock Grid.Column="1"
                                       Text="About"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle x:Name="AboutNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1">
            <ScrollViewer Padding="36,24,36,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="AppearancePanel" MaxWidth="1064"
                                Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}"
                                   Text="Appearance &amp; behavior" />
                        <toolkit:SettingsCard Description="Select which app theme to display"
                                              Header="App theme">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Width="20" Height="20"
                                          Data="M7.99994 6C6.89537 6 5.99994 6.89543 5.99994 8C5.99994 9.10457 6.89537 10 7.99994 10C9.10451 10 9.99994 9.10457 9.99994 8C9.99994 6.89543 9.10451 6 7.99994 6ZM6.99994 8C6.99994 7.44772 7.44765 7 7.99994 7C8.55222 7 8.99994 7.44772 8.99994 8C8.99994 8.55228 8.55222 9 7.99994 9C7.44765 9 6.99994 8.55228 6.99994 8ZM10.618 4.39833C10.233 4.46825 9.86392 4.21413 9.7937 3.83074L9.53397 2.41496C9.50816 2.27427 9.39961 2.16301 9.25912 2.13325C8.84818 2.04621 8.42685 2.00195 8 2.00195C7.57289 2.00195 7.1513 2.04627 6.74013 2.13341C6.5996 2.1632 6.49104 2.27452 6.46529 2.41527L6.20629 3.8308C6.1994 3.86844 6.18942 3.90551 6.17647 3.9416C6.04476 4.30859 5.6392 4.49978 5.27062 4.36863L3.91115 3.88463C3.77603 3.83652 3.62511 3.87431 3.52891 3.98033C2.96005 4.60729 2.52892 5.34708 2.2672 6.15302C2.22305 6.28899 2.26562 6.43805 2.37502 6.53053L3.47694 7.46206C3.50626 7.48685 3.53352 7.51399 3.55843 7.5432C3.81177 7.84027 3.77528 8.28558 3.47693 8.53783L2.37502 9.46935C2.26562 9.56183 2.22305 9.71089 2.2672 9.84685C2.52892 10.6528 2.96005 11.3926 3.52891 12.0196C3.62511 12.1256 3.77603 12.1634 3.91115 12.1153L5.27068 11.6312C5.30687 11.6184 5.3441 11.6084 5.38196 11.6015C5.76701 11.5316 6.13608 11.7857 6.2063 12.1691L6.46529 13.5846C6.49104 13.7254 6.5996 13.8367 6.74013 13.8665C7.1513 13.9536 7.57289 13.9979 8 13.9979C8.42685 13.9979 8.84818 13.9537 9.25912 13.8666C9.39961 13.8369 9.50816 13.7256 9.53397 13.5849L9.79368 12.1692C9.8006 12.1314 9.81058 12.0944 9.82353 12.0583C9.95524 11.6913 10.3608 11.5001 10.7294 11.6312L12.0888 12.1153C12.224 12.1634 12.3749 12.1256 12.4711 12.0196C13.04 11.3926 13.4711 10.6528 13.7328 9.84685C13.777 9.71089 13.7344 9.56183 13.625 9.46935L12.5231 8.53782C12.4937 8.51303 12.4665 8.48589 12.4416 8.45667C12.1882 8.1596 12.2247 7.71429 12.5231 7.46205L13.625 6.53053C13.7344 6.43805 13.777 6.28899 13.7328 6.15302C13.4711 5.34708 13.04 4.60729 12.4711 3.98033C12.3749 3.87431 12.224 3.83652 12.0888 3.88463