<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="SettingsPage"
    AutomationProperties.Name="Settings"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock"
               BasedOn="{StaticResource TitleTextBlockStyle}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="1,30,0,6" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="4,2,4,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <!-- A two-pane settings shell: the real NavigationView control needs
         framework style keys this runtime cannot resolve, so the same Fluent
         hierarchy is built from native Buttons and panels. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Padding="0,24,0,0">
            <TextBlock Text="Settings"
                       Style="{StaticResource SettingsPageTitleStyle}"
                       AutomationProperties.HeadingLevel="Level1"
                       Margin="24,0,16,20" />
            <StackPanel Margin="0,56,0,0">
                <Grid>
                    <Button x:Name="AppearanceNavButton"
                            Style="{StaticResource SettingsNavButtonStyle}"
                            Tag="Appearance"
                            AutomationProperties.Name="Appearance"
                            AutomationProperties.AutomationId="AppearanceNavItem"
                            Click="SettingsNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                                      Data="M 5.5,1.999 A 0.5,0.5,0,0,0,5,2.499 L 5,11.003 A 2,2,0,0,0,7,13.003 L 8.004,13.003 L 8.004,16.001 A 2,2,0,1,0,12.004,16.001 L 12.004,13.003 L 13,13.003 A 2,2,0,0,0,15,11.003 L 15,2.5 A 0.5,0.5,0,0,0,14.5,2 Z M 6,10.003 L 14,10.003 L 14,11.003 A 1,1,0,0,1,13,12.003 L 11.504,12.003 A 0.5,0.5,0,0,0,11.004,12.503 L 11.004,16.001 A 1,1,0,1,1,9.004,16.001 L 9.004,12.503 A 0.5,0.5,0,0,0,8.504,12.003 L 7,12.003 A 1,1,0,0,1,6,11.003 Z M 14,9.003 L 6,9.003 L 6,3 L 10,3 L 10,4.5 A 0.5,0.5,0,0,0,11,4.5 L 11,3 L 12,3 L 12,5.502 A 0.5,0.5,0,0,0,13,5.502 L 13,3 L 14,3 Z" />
                            <TextBlock Grid.Column="1"
                                       Text="Appearance"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle x:Name="AppearanceNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False" />
                </Grid>
                <Grid>
                    <Button x:Name="AboutNavButton"
                            Style="{StaticResource SettingsNavButtonStyle}"
                            Tag="About"
                            AutomationProperties.Name="About"
                            AutomationProperties.AutomationId="AboutNavItem"
                            Click="SettingsNavButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Width="20" Height="20" VerticalAlignment="Center"
                                      Data="M 10.492,8.91 A 0.5,0.5,0,0,0,9.5,9 L 9.5,13.502 L 9.508,13.592 A 0.5,0.5,0,0,0,10.5,13.502 L 10.5,9 Z M 10.799,6.75 A 0.75,0.75,0,1,0,9.299,6.75 A 0.75,0.75,0,0,0,10.799,6.75 M 18,10 A 8,8,0,1,0,2,10 A 8,8,0,0,0,18,10 M 3,10 A 7,7,0,1,1,17,10 A 7,7,0,0,1,3,10" />
                            <TextBlock Grid.Column="1"
                                       Text="About"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Rectangle x:Name="AboutNavIndicator"
                               Width="3"
                               Height="16"
                               RadiusX="2"
                               RadiusY="2"
                               Margin="4,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1">
            <ScrollViewer Padding="36,24,36,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="AppearancePanel" MaxWidth="1064"
                                Spacing="{StaticResource SettingsCardSpacing}">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}"
                                   Text="Appearance &amp; behavior" />
                        <toolkit:SettingsCard Description="Select which app theme to display"
                                              Header="App theme">
                            <toolkit:SettingsCard.HeaderIcon>
                                <PathIcon Width="16" Height="16"
                                          Data="M 7.5,5.5 A 0.5,0.5,0,1,0,7.5,4.5 A 0.5,0.5,0,0,0,7.5,5.5 M 10,5.5 A 0.5,0.5,0,1,1,9,5.5 A 0.5,0.5,0,0,1,10,5.5 M 11.5,7 A 0.5,0.5,0,1,1,10.5,7 A 0.5,0.5,0,0,1,11.5,7 M 11,9.5 A 0.5,0.5,0,1,0,11,8.5 A 0.5,0.5,0,0,0,11,9.5 M 10.5,11 A 0.5,0.5,0,1,1,9.5,11 A 0.5,0.5,0,0,1,10.5,11 M 8,2 A 6,6,0,0,0,2,8 A 2,2,0,0,0,4,10 C 4.708,10,5.085,9.622,5.34,9.367 L 5.354,9.354 C 5.598,9.109,5.72,9,6,9 A 1,1,0,0,1,7,10 L 7,11 A 3,3,0,0,0,10,14 C 11.334,14,12.354,13.254,13.017,12.146 C 13.672,11.05,14,9.579,14,8 A 6,6,0,0,0,8,2 M 3,8 A 5,5,0,0,1,13,8 C 13,9.458,12.695,10.737,12.159,11.632 C 11.63,12.515,10.9,13,10,13 A 2,2,0,0,1,8,11 L 8,10 A 2,2,0,0,0,6,8 C 5.292,8,4.915,8.378,4.66,8.633 L 4.646,8.646 C 4.402,8.891,4.28,9,4,9 A 1,1,0,0,1,3,8" />
                            </toolkit:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeComboBox"
                                      SelectedIndex="-1"
                                      AutomationProperties.AutomationId="ThemeComboBox"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Light" Tag="Light"
                                              AutomationProperties.AutomationId="ThemeLight" />
                                <ComboBoxItem Content="Dark" Tag="Dark"
                                              AutomationProperties.AutomationId="ThemeDark" />
                                <ComboBoxItem Content="Use system setting" Tag="System"
                                              AutomationProperties.AutomationId="ThemeSystem" />
                            </ComboBox>
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" MaxWidth="1064"
                                Spacing="{StaticResource SettingsCardSpacing}"
                                Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}"
                                   Text="About" />
                        <toolkit:SettingsCard Header="NopeView"
                                              Description="A fast, lightweight image viewer">
                            <TextBlock x:Name="VersionText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Repository"
                                              Description="Source code on GitHub">
                            <HyperlinkButton Content="NopeKat/NopeView"
                                             NavigateUri="https://github.com/NopeKat/NopeView" />
                        </toolkit:SettingsCard>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
