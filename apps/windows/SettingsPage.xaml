<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="SettingsPage"
    AutomationProperties.Name="Settings"
    Background="Transparent">

    <!-- The official NavigationView owns the pane, selection indicator,
         keyboard navigation and item accessibility. Content is hosted by a
         Frame, so each section is a normal Page. -->
    <NavigationView x:Name="SettingsNavigation"
                    PaneDisplayMode="Auto"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="True"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    SelectionChanged="SettingsNavigation_SelectionChanged"
                    AutomationProperties.AutomationId="SettingsNavigation">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="AppearanceNavItem"
                                Content="Appearance"
                                Tag="Appearance"
                                IsSelected="True"
                                AutomationProperties.AutomationId="AppearanceNavItem">
                <NavigationViewItem.Icon>
                    <PathIcon Width="16" Height="16"
                              Data="M 3.5,1 A 0.5,0.5,0,0,0,3,1.5 L 3,9 A 2,2,0,0,0,5,11 L 6,11 L 6,13 A 2,2,0,1,0,10,13 L 10,11 L 11,11 A 2,2,0,0,0,13,9 L 13,1.5 A 0.5,0.5,0,0,0,12.5,1 Z M 4,7 L 4,2 L 8,2 L 8,3.5 A 0.5,0.5,0,0,0,9,3.5 L 9,2 L 10,2 L 10,4.5 A 0.5,0.5,0,0,0,11,4.5 L 11,2 L 12,2 L 12,7 Z M 4,8 L 12,8 L 12,9 A 1,1,0,0,1,11,10 L 9.5,10 A 0.5,0.5,0,0,0,9,10.5 L 9,13 A 1,1,0,1,1,7,13 L 7,10.5 A 0.5,0.5,0,0,0,6.5,10 L 5,10 A 1,1,0,0,1,4,9 Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutNavItem"
                                Content="About"
                                Tag="About"
                                AutomationProperties.AutomationId="AboutNavItem">
                <NavigationViewItem.Icon>
                    <PathIcon Width="16" Height="16"
                              Data="M 8.499,7.5 A 0.5,0.5,0,1,0,7.499,7.5 L 7.499,10.5 A 0.5,0.5,0,0,0,8.499,10.5 Z M 8.749,5.5 A 0.749,0.749,0,1,1,7.25,5.5 A 0.749,0.749,0,0,1,8.748,5.5 M 8,1 A 7,7,0,1,0,8,15 A 7,7,0,0,0,8,1 M 2,8 A 6,6,0,1,1,14,8 A 6,6,0,0,1,2,8" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="SettingsContentFrame"
               AutomationProperties.AutomationId="SettingsContentFrame" />
    </NavigationView>
</Page>
