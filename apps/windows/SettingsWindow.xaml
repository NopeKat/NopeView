<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <!-- The official TitleBar control owns the caption. The transparent root
         lets the Mica backdrop show through. -->
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The official title bar control draws the caption and system
             buttons. The custom close button and empty drag strip are gone. -->
        <TitleBar x:Name="SettingsTitleBar"
                  Grid.Row="0"
                  Title="Settings"
                  AutomationProperties.AutomationId="SettingsTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/nopeview-title.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="SettingsFrame" Grid.Row="1" Background="Transparent" />
    </Grid>
</Window>
