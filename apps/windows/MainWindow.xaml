<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <!-- Hidden placement keeps WinUI from turning the window-wide keyboard
         accelerators into hover tooltips on every control. -->
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded"
          KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="PreviousAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="NextAccelerator_Invoked" />
            <KeyboardAccelerator Key="Add" Invoked="ZoomInAccelerator_Invoked" />
            <KeyboardAccelerator Key="Subtract" Invoked="ZoomOutAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number0" Invoked="ActualSizeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Invoked="FitAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Invoked="RotateAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="PlayPauseAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyImageAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAsAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- Toolbar buttons follow the official AppBarButton colors from
                 the WinUI 3 source (transparent at rest, subtle fill on hover
                 and press) while keeping the default Button template. -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,5,8,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <!-- The default button template fills disabled buttons with
                     ButtonBackgroundDisabled, which reads as a gray chip on the
                     floating toolbar. AppBarButton keeps the surface and only
                     dims the icon, so the toolbar does the same. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{ThemeResource ButtonBackgroundPressed}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background"
                                                    Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                            <Setter Target="ContentPresenter.Foreground"
                                                    Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The official title bar control owns the caption, drag region and
             system buttons. The window extends its content into the title bar
             so this row sits where the native strip would be. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="NopeView"
                  AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/nopeview-title.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <Grid x:Name="ContentRoot" Grid.Row="1"
              Background="{ThemeResource ViewerBackgroundBrush}">
            <Grid x:Name="Viewport"
                  Background="#01000000"
