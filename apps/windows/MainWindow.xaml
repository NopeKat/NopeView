<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <!-- Caption buttons are drawn in XAML so their tooltips can be omitted.
                 Geometry and colors follow the system caption buttons.
                 Minimize and Restore use theme hover/pressed backgrounds;
                 Close keeps the native danger colors on hover and press. -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CaptionGlyphBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"
                                                        Value="{ThemeResource CaptionHoverBrush}" />
                                                <!-- Hovering an inactive window restores the
                                                     bright glyph, matching native behavior. -->
                                                <Setter Target="ContentPresenter.Foreground"
                                                        Value="{ThemeResource CaptionGlyphBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"
                                                        Value="{ThemeResource CaptionPressedBrush}" />
                                                <Setter Target="ContentPresenter.Foreground"
                                                        Value="{ThemeResource CaptionGlyphBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The close button keeps the system danger color on hover and press. -->
            <Style x:Key="CloseButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CaptionGlyphBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#E81123" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#FCE1E3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#C42B1C" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom-drawn title bar with its own caption buttons; the system
             title bar is collapsed so it draws no buttons or tooltips. The row
             is registered as the drag region through SetTitleBar. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="12,0,0,0">
                <Image x:Name="AppLogo"
                       Source="ms-appx:///Assets/nopeview-title.png"
                       Width="16" Height="16" />
                <TextBlock Text="NopeView"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="8,0,0,0" x:Name="TitleText" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.AutomationId="Minimize"
                        AutomationProperties.Name="Minimize"
                        Click="MinimizeButton_Click">
                    <!-- Fluent UI System Icons, rendered as vector PathIcon. -->
                    <PathIcon Width="16" Height="16"
                              RenderTransformOrigin="0.5,0.5"
                              Data="M3 8c0-.28.22-.5.5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8">
                        <PathIcon.RenderTransform>
                            <TranslateTransform x:Name="MinimizeOffset" Y="-1" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </Button>
                <Button x:Name="RestoreButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.AutomationId="Restore"
                        AutomationProperties.Name="Restore"
                        Click="RestoreButton_Click">
                    <!-- Maximized state shows the restore glyph; restored state
                         shows the maximize glyph. Code toggles visibility. -->
                    <Grid>
                        <PathIcon x:Name="RestoreGlyph" Width="16" Height="16"
                                  Data="M5.08 4c.21-.58.77-1 1.42-1H10a3 3 0 0 1 3 3v3.5c0 .65-.42 1.2-1 1.41V6a2 2 0 0 0-2-2zM4.5 5h5c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5h-5A1.5 1.5 0 0 1 3 11.5v-5C3 5.67 3.67 5 4.5 5m0 1a.5.5 0 0 0-.5.5v5c0 .28.22.5.5.5h5a.5.5 0 0 0 .5-.5v-5a.5.5 0 0 0-.5-.5z" />
                        <!-- Fluent maximize_16_regular geometry. Its inner
                             rectangle is redrawn counter-clockwise so the
                             nonzero fill rule punches it out; the shape itself
                             is unchanged and the box stays 10 units = 20 px. -->
                        <PathIcon x:Name="MaximizeGlyph" Width="16" Height="16"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="M4.5 3C3.67 3 3 3.67 3 4.5v7c0 .83.67 1.5 1.5 1.5h7c.83 0 1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zM4 4V12H12V4Z">
                            <PathIcon.RenderTransform>
                                <TranslateTransform Y="-0.5" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        AutomationProperties.AutomationId="Close"
                        AutomationProperties.Name="Close"
                        Click="CloseButton_Click">
                    <!-- Fluent UI System Icons dismiss_16_regular. The path data
                         is pre-scaled to match the 20x20 px caption glyph. -->
                    <PathIcon Width="16" Height="16"
                              RenderTransformOrigin="0.5,0.5"
                              Data="M3.1297 3.2441L3.1818 3.1818C3.3380 3.0256 3.5805 3.0082 3.7559 3.1297L3.8182 3.1818L8 7.3637L12.1818 3.1818C12.3575 3.0061 12.6425 3.0061 12.8182 3.1818C12.9939 3.3575 12.9939 3.6425 12.8182 3.8182L8.6363 8L12.8182 12.1818C12.9744 12.3380 12.9918 12.5805 12.8703 12.7559L12.8182 12.8182C12.6620 12.9744 12.4195 12.9918 12.2441 12.8703L12.1818 12.8182L8 8.6363L3.8182 12.8182C3.6425 12.9939 3.3575 12.9939 3.1818 12.8182C3.0061 12.6425 3.0061 12.3575 3.1818 12.1818L7.3637 8L3.1818 3.8182C3.0256 3.6620 3.0082 3.4195 3.1297 3.2441L3.1818 3.1818L3.1297 3.2441Z">
                        <PathIcon.RenderTransform>
                            <TranslateTransform x:Name="CloseOffset" Y="-0.5" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1" />
    </Grid>
</Window>
