<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Invoked="PreviousAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="NextAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- Caption buttons are drawn in XAML so their tooltips can be omitted.
                 Geometry and colors follow the system caption buttons.
                 Minimize and Restore use theme hover/pressed backgrounds;
                 Close keeps the native danger colors on hover and press. -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource CaptionGlyphBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"
                                                        Value="{ThemeResource CaptionHoverBrush}" />
                                                <!-- Hovering an inactive window restores the
                                                     bright glyph, matching native behavior. -->
                                                <Setter Target="ContentPresenter.Foreground"
                                                        Value="{ThemeResource CaptionGlyphBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background"
                                                        Value="{ThemeResource CaptionPressedBrush}" />
                                                <Setter Target="ContentPresenter.Foreground"
                                                        Value="{ThemeResource CaptionGlyphBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The close button keeps the system danger color on hover and press. -->
            <Style x:Key="CloseButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CaptionGlyphBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#E81123" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#FCE1E3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="#C42B1C" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom-drawn title bar with its own caption buttons; the system
             title bar is collapsed so it draws no buttons or tooltips. The row
             is registered as the drag region through SetTitleBar. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="12,0,0,0">
                <Image x:Name="AppLogo"
                       Source="ms-appx:///Assets/nopeview-title.png"
                       Width="16" Height="16" />
                <TextBlock Text="NopeView"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="8,0,0,0" x:Name="TitleText" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.AutomationId="Minimize"
                        AutomationProperties.Name="Minimize"
                        Click="MinimizeButton_Click">
                    <!-- Fluent UI System Icons, rendered as vector PathIcon. -->
                    <PathIcon Width="16" Height="16"
                              RenderTransformOrigin="0.5,0.5"
                              Data="M3 8c0-.28.22-.5.5-.5h9a.5.5 0 0 1 0 1h-9A.5.5 0 0 1 3 8">
                        <PathIcon.RenderTransform>
                            <TranslateTransform x:Name="MinimizeOffset" Y="-1" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </Button>
                <Button x:Name="RestoreButton"
                        Style="{StaticResource CaptionButtonStyle}"
                        AutomationProperties.AutomationId="Restore"
                        AutomationProperties.Name="Restore"
                        Click="RestoreButton_Click">
                    <!-- Maximized state shows the restore glyph; restored state
                         shows the maximize glyph. Code toggles visibility. -->
                    <Grid>
                        <PathIcon x:Name="RestoreGlyph" Width="16" Height="16"
                                  Data="M5.08 4c.21-.58.77-1 1.42-1H10a3 3 0 0 1 3 3v3.5c0 .65-.42 1.2-1 1.41V6a2 2 0 0 0-2-2zM4.5 5h5c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5h-5A1.5 1.5 0 0 1 3 11.5v-5C3 5.67 3.67 5 4.5 5m0 1a.5.5 0 0 0-.5.5v5c0 .28.22.5.5.5h5a.5.5 0 0 0 .5-.5v-5a.5.5 0 0 0-.5-.5z" />
                        <!-- Fluent maximize_16_regular geometry. Its inner
                             rectangle is redrawn counter-clockwise so the
                             nonzero fill rule punches it out; the shape itself
                             is unchanged and the box stays 10 units = 20 px. -->
                        <PathIcon x:Name="MaximizeGlyph" Width="16" Height="16"
                                  Visibility="Collapsed"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="M4.5 3C3.67 3 3 3.67 3 4.5v7c0 .83.67 1.5 1.5 1.5h7c.83 0 1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zM4 4V12H12V4Z">
                            <PathIcon.RenderTransform>
                                <TranslateTransform Y="-0.5" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        AutomationProperties.AutomationId="Close"
                        AutomationProperties.Name="Close"
                        Click="CloseButton_Click">
                    <!-- Fluent UI System Icons dismiss_16_regular. The path data
                         is pre-scaled to match the 20x20 px caption glyph. -->
                    <PathIcon Width="16" Height="16"
                              RenderTransformOrigin="0.5,0.5"
                              Data="M3.1297 3.2441L3.1818 3.1818C3.3380 3.0256 3.5805 3.0082 3.7559 3.1297L3.8182 3.1818L8 7.3637L12.1818 3.1818C12.3575 3.0061 12.6425 3.0061 12.8182 3.1818C12.9939 3.3575 12.9939 3.6425 12.8182 3.8182L8.6363 8L12.8182 12.1818C12.9744 12.3380 12.9918 12.5805 12.8703 12.7559L12.8182 12.8182C12.6620 12.9744 12.4195 12.9918 12.2441 12.8703L12.1818 12.8182L8 8.6363L3.8182 12.8182C3.6425 12.9939 3.3575 12.9939 3.1818 12.8182C3.0061 12.6425 3.0061 12.3575 3.1818 12.1818L7.3637 8L3.1818 3.8182C3.0256 3.6620 3.0082 3.4195 3.1297 3.2441L3.1818 3.1818L3.1297 3.2441Z">
                        <PathIcon.RenderTransform>
                            <TranslateTransform x:Name="CloseOffset" Y="-0.5" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentRoot" Grid.Row="1"
              Background="{ThemeResource ViewerBackgroundBrush}">
            <Grid x:Name="Viewport"
                  Background="#01000000"
                  SizeChanged="Viewport_SizeChanged">
                <Image x:Name="ImageView"
                       AutomationProperties.AutomationId="ImageView"
                       AutomationProperties.Name="Current image"
                       IsHitTestVisible="False"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="ImageTransform" />
                    </Image.RenderTransform>
                </Image>

                <!-- Thumb handles drag input reliably inside the WinUI host.
                     Opacity 0 keeps it invisible while still hit-testable. -->
                <Thumb x:Name="PanThumb"
                       AutomationProperties.AccessibilityView="Raw"
                       Background="#01000000"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       IsTabStop="False"
                       DragDelta="PanThumb_DragDelta"
                       PointerWheelChanged="PanThumb_PointerWheelChanged" />
            </Grid>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12"
                    Padding="2"
                    CornerRadius="6"
                    Background="{ThemeResource FloatingPanelBrush}"
                    BorderBrush="{ThemeResource FloatingPanelStrokeBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="OpenButton"
                            AutomationProperties.AutomationId="OpenButton"
                            AutomationProperties.Name="Open image"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,6"
                            MinHeight="32"
                            Click="OpenButton_Click"
                            ToolTipService.ToolTip="Open image (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="16" Height="16"
                                      Data="M13 6a2 2 0 00-2-2H6.17l-1.1-.9a.5.5 0 00-.32-.1H3a2 2 0 00-2 2v6c0 1.1.9 2 2 2h9.25a1.5 1.5 0 001.44-1.08l1.17-4A1.5 1.5 0 0013.42 6H13zM3 4h1.58l1.1.89c.1.07.2.1.32.1h5a1 1 0 011 1V6H4.25a1.5 1.5 0 00-1.44 1.08L2 9.86V5a1 1 0 011-1zm.77 3.36A.5.5 0 014.25 7h9.17a.5.5 0 01.48.64l-1.17 4a.5.5 0 01-.48.36H3.08a.5.5 0 01-.48-.64l1.17-4z" />
                            <TextBlock Text="Open" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>

                    <Border Width="1"
                            Height="20"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource FloatingPanelStrokeBrush}" />

                    <Button x:Name="PreviousButton"
                            AutomationProperties.AutomationId="PreviousButton"
                            AutomationProperties.Name="Previous image"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            MinHeight="32"
                            MinWidth="32"
                            IsEnabled="False"
                            Click="PreviousButton_Click"
                            ToolTipService.ToolTip="Previous image (Left)">
                        <PathIcon Width="16" Height="16"
                                  Data="M10.35 3.15c.2.2.2.5 0 .7L6.21 8l4.14 4.15a.5.5 0 01-.7.7l-4.5-4.5a.5.5 0 010-.7l4.5-4.5c.2-.2.5-.2.7 0z" />
                    </Button>

                    <Button x:Name="NextButton"
                            AutomationProperties.AutomationId="NextButton"
                            AutomationProperties.Name="Next image"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            MinHeight="32"
                            MinWidth="32"
                            IsEnabled="False"
                            Click="NextButton_Click"
                            ToolTipService.ToolTip="Next image (Right)">
                        <PathIcon Width="16" Height="16"
                                  Data="M5.65 3.15a.5.5 0 000 .7L9.79 8l-4.14 4.15a.5.5 0 00.7.7l4.5-4.5a.5.5 0 000-.7l-4.5-4.5a.5.5 0 00-.7 0z" />
                    </Button>

                    <StackPanel x:Name="AnimationControls"
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="Collapsed">
                        <Border Width="1"
                                Height="20"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource FloatingPanelStrokeBrush}" />

                        <Button x:Name="PlayPauseButton"
                                AutomationProperties.AutomationId="PlayPauseButton"
                                AutomationProperties.Name="Play or pause animation"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,6"
                                MinHeight="32"
                                Click="PlayPauseButton_Click"
                                ToolTipService.ToolTip="Pause or continue the animation">
                            <TextBlock x:Name="PlayPauseLabel"
                                       AutomationProperties.AutomationId="PlayPauseLabel"
                                       Text="Pause"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Button>

                        <Button x:Name="LoopButton"
                                AutomationProperties.AutomationId="LoopButton"
                                AutomationProperties.Name="Loop animation"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="10,6"
                                MinHeight="32"
                                Click="LoopButton_Click"
                                ToolTipService.ToolTip="Toggle looping">
                            <TextBlock x:Name="LoopLabel"
                                       AutomationProperties.AutomationId="LoopLabel"
                                       Text="Loop on"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <Border Width="1"
                            Height="20"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource FloatingPanelStrokeBrush}" />

                    <StackPanel x:Name="ViewControls"
                                Orientation="Horizontal"
                                Spacing="2">
                        <Button x:Name="ZoomOutButton"
                                AutomationProperties.AutomationId="ZoomOutButton"
                                AutomationProperties.Name="Zoom out"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                MinHeight="32"
                                MinWidth="32"
                                IsEnabled="False"
                                Click="ZoomOutButton_Click"
                                ToolTipService.ToolTip="Zoom out">
                            <PathIcon Width="16" Height="16"
                                      Data="M3 8c0-.28.22-.5.5-.5h9a.5.5 0 010 1h-9A.5.5 0 013 8z" />
                        </Button>

                        <Button x:Name="ZoomInButton"
                                AutomationProperties.AutomationId="ZoomInButton"
                                AutomationProperties.Name="Zoom in"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                MinHeight="32"
                                MinWidth="32"
                                IsEnabled="False"
                                Click="ZoomInButton_Click"
                                ToolTipService.ToolTip="Zoom in">
                            <PathIcon Width="16" Height="16"
                                      Data="M7.91 3H8a.5.5 0 01.5.41V7.5h4a.5.5 0 01.5.41V8a.5.5 0 01-.41.5H8.5v4a.5.5 0 01-.41.5H8a.5.5 0 01-.5-.41V8.5h-4a.5.5 0 01-.5-.41V8a.5.5 0 01.41-.5H7.5v-4a.5.5 0 01.41-.5H8h-.09z" />
                        </Button>

                        <Button x:Name="RotateButton"
                                AutomationProperties.AutomationId="RotateButton"
                                AutomationProperties.Name="Rotate clockwise"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                MinHeight="32"
                                MinWidth="32"
                                IsEnabled="False"
                                Click="RotateButton_Click"
                                ToolTipService.ToolTip="Rotate clockwise">
                            <PathIcon Width="16" Height="16"
                                      Data="M3.07 9.05a7 7 0 0112.55-3.22l.13.17H12.5a.5.5 0 100 1h4a.5.5 0 00.5-.5v-4a.5.5 0 00-1 0v2.2a8 8 0 101.99 4.77.5.5 0 00-1 .08 7 7 0 11-13.92-.5z" />
                        </Button>

                        <Button x:Name="FitButton"
                                AutomationProperties.AutomationId="FitButton"
                                AutomationProperties.Name="Fit image"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                MinHeight="32"
                                MinWidth="32"
                                IsEnabled="False"
                                Click="FitButton_Click"
                                ToolTipService.ToolTip="Fit image">
                            <PathIcon Width="16" Height="16"
                                      Data="M3.75 3a.75.75 0 0 0-.75.75V5.5a.5.5 0 0 1-1 0V3.75C2 2.78 2.78 2 3.75 2H5.5a.5.5 0 0 1 0 1zM10 2.5c0-.28.22-.5.5-.5h1.75c.97 0 1.75.78 1.75 1.75V5.5a.5.5 0 0 1-1 0V3.75a.75.75 0 0 0-.75-.75H10.5a.5.5 0 0 1-.5-.5M2.5 10c.28 0 .5.22.5.5v1.75c0 .41.34.75.75.75H5.5a.5.5 0 0 1 0 1H3.75C2.78 14 2 13.22 2 12.25V10.5c0-.28.22-.5.5-.5m11 0c.28 0 .5.22.5.5v1.75c0 .97-.78 1.75-1.75 1.75H10.5a.5.5 0 0 1 0-1h1.75c.41 0 .75-.34.75-.75V10.5c0-.28.22-.5.5-.5" />
                        </Button>

                        <Button x:Name="ActualSizeButton"
                                AutomationProperties.AutomationId="ActualSizeButton"
                                AutomationProperties.Name="Actual size"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,6"
                                MinHeight="32"
                                MinWidth="36"
                                IsEnabled="False"
                                Click="ActualSizeButton_Click"
                                ToolTipService.ToolTip="Actual size (1:1)">
                            <TextBlock Text="1:1" FontSize="12" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    MaxWidth="640"
                    Margin="24"
                    Padding="16,12"
                    CornerRadius="8"
                    Background="{ThemeResource FloatingPanelBrush}"
                    BorderBrush="{ThemeResource FloatingPanelStrokeBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PathIcon Width="16"
                              Height="16"
                              VerticalAlignment="Top"
                              Foreground="{ThemeResource FloatingPanelErrorBrush}"
                              Data="M8 2a6 6 0 110 12A6 6 0 018 2zm0 1a5 5 0 100 10A5 5 0 008 3zm0 7a.75.75 0 110 1.5.75.75 0 010-1.5zm0-5.5a.5.5 0 01.5.41V8.5a.5.5 0 01-1 .09V5c0-.28.22-.5.5-.5z" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Could not open image"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource FloatingPanelPrimaryTextBrush}" />
                        <TextBlock x:Name="ErrorText"
                                   AutomationProperties.AutomationId="ErrorText"
                                   AutomationProperties.Name="Image error"
                                   Foreground="{ThemeResource FloatingPanelSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ViewStatusPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="16"
                    Padding="10,4"
                    CornerRadius="6"
                    Background="{ThemeResource FloatingPanelBrush}"
                    BorderBrush="{ThemeResource FloatingPanelStrokeBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="ViewStatusText"
                           AutomationProperties.AutomationId="ViewStatus"
                           AutomationProperties.Name="View status"
                           FontSize="12"
                           Foreground="{ThemeResource FloatingPanelSecondaryTextBrush}"
                           Text="100% | 0 deg" />
            </Border>
        </Grid>
    </Grid>
</Window>
