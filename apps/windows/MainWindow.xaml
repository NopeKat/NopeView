<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView - PNG vertical slice">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock x:Name="StatusText" FontSize="15" TextWrapping="Wrap" Text="starting..." />
        <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap" />
        <Image x:Name="ImageView" Stretch="None" HorizontalAlignment="Left" />
    </StackPanel>
</Window>
