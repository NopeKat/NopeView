<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <!-- Command shortcuts live on their buttons so Fluent tooltips can show
         them. The clipboard commands are overflow items that WinUI unloads
         while the popup is closed, so their keys stay global here and the
         buttons carry the shortcut text instead. -->
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded"
          KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyImageAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAsAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ViewerSectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SettingsSectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="AboutSectionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The official TitleBar owns the caption, drag region, back slot and
             pane toggle button. The pane button is forwarded to NavigationView
             through PaneToggleRequested, matching the WinUI guidance. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="NopeView"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested"
                  IsBackButtonVisible="False"
                  AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/nopeview-title.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Top-level destinations share one navigation pane. Compact mode
             keeps the three entry points visible as icons while the image
             still gets most of the width. -->
        <NavigationView x:Name="TopLevelNav"
                        Grid.Row="1"
                        PaneDisplayMode="LeftMinimal"
                        OpenPaneLength="320"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        IsPaneOpen="False"
                        Padding="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        AutomationProperties.AutomationId="TopLevelNav"
                        SelectionChanged="TopLevelNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ViewerNavItem"
                                    Tag="viewer"
                                    AutomationProperties.AutomationId="ViewerNavItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem"
                                    Tag="settings"
                                    AutomationProperties.AutomationId="SettingsNavItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem"
                                    Tag="about"
                                    AutomationProperties.AutomationId="AboutNavItem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid x:Name="PageHost">
                <Grid x:Name="ContentRoot"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- The official InfoBar owns the error layout, severity colors,
                 icon and text metrics. It sits below the command layer and
                 pushes the viewer down instead of covering the image. -->
            <InfoBar x:Name="ErrorPanel"
                     Grid.Row="1"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="24,8,24,0"
                     AutomationProperties.AutomationId="ErrorInfoBar" />
            <Grid x:Name="Viewport"
                  Grid.Row="2"
                  Background="Transparent"
                  SizeChanged="Viewport_SizeChanged"
                  PointerWheelChanged="Viewport_PointerWheelChanged">
                <Grid.ContextFlyout>
                    <!-- The same menu is shown from the toolbar's actions
                         button, so every command stays reachable without a
                         right-click. -->
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="CopyImageMenuItem"
                                        AutomationProperties.AutomationId="ContextCopyImage"
                                        IsEnabled="False"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Click="CopyImageMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="CopyPathMenuItem"
                                        AutomationProperties.AutomationId="ContextCopyPath"
                                        IsEnabled="False"
                                        Click="CopyPathMenuItem_Click"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SaveAsMenuItem"
                                        AutomationProperties.AutomationId="ContextSaveAs"
                                        IsEnabled="False"
                                        Click="SaveAsMenuItem_Click"
                                        KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ShowInExplorerMenuItem"
                                        AutomationProperties.AutomationId="ContextShowInExplorer"
                                        IsEnabled="False"
                                        Click="ShowInExplorerMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="FitMenuItem"
                                        AutomationProperties.AutomationId="ContextFit"
                                        IsEnabled="False"
                                        Click="FitMenuItem_Click"
                                        KeyboardAcceleratorTextOverride="F">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9A6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="ActualSizeMenuItem"
                                        AutomationProperties.AutomationId="ContextActualSize"
                                        IsEnabled="False"
                                        Click="ActualSizeMenuItem_Click"
                                        KeyboardAcceleratorTextOverride="0">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="1:1" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SettingsMenuItem"
                                        AutomationProperties.AutomationId="ContextSettings"
                                        KeyboardAcceleratorTextOverride="Ctrl+,"
                                        Click="SettingsMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <!-- The frame is sized to the fitted bitmap, not the viewport,
                     so an optional edge treatment can follow the image bounds
                     through zoom, pan and rotation. The image itself fills the
                     frame; the viewport stays the gesture and clipping surface. -->
                <Grid x:Name="ImageFrame"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="ImageTransform" />
                    </Grid.RenderTransform>
                    <Image x:Name="ImageView"
                           AutomationProperties.AutomationId="ImageView"
                           IsHitTestVisible="False"
                           Stretch="Uniform" />
                    <Rectangle x:Name="ImageFrameStroke"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                               StrokeThickness="1" />
                </Grid>

                <!-- The viewport itself receives pointer input. No extra
                     transparent Thumb or control-template override is needed
                     for panning. -->
                <ProgressRing x:Name="LoadingRing"
                              AutomationProperties.AutomationId="LoadingRing"
                              Width="32"
                              Height="32"
                              IsActive="False"
                              IsHitTestVisible="False"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <!-- Empty state. Without it a fresh launch is a blank canvas
                     with a disabled toolbar and no hint about what to do. -->
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            AutomationProperties.AutomationId="EmptyState">
                    <Viewbox Width="48"
                             Height="48"
                             HorizontalAlignment="Center">
                        <Path Width="20"
                              Height="20"
                              Fill="{ThemeResource TextFillColorTertiaryBrush}"
                              Stretch="Uniform"
                              Data="M 14,7.5 A 1.5,1.5,0,1,1,11,7.5 A 1.5,1.5,0,0,1,14,7.5 M 13,7.5 A 0.5,0.5,0,1,0,12,7.5 A 0.5,0.5,0,0,0,13,7.5 M 3,6 A 3,3,0,0,1,6,3 L 14,3 A 3,3,0,0,1,17,6 L 17,14 A 3,3,0,0,1,14,17 L 6,17 A 3,3,0,0,1,3,14 Z M 6,4 A 2,2,0,0,0,4,6 L 4,14 C 4,14.373,4.102,14.722,4.28,15.02 L 8.949,10.432 A 1.5,1.5,0,0,1,11.051,10.432 L 15.721,15.02 A 2,2,0,0,0,16,14 L 16,6 A 2,2,0,0,0,14,4 Z M 6,16 L 14,16 C 14.37,16,14.715,15.9,15.012,15.726 L 10.35,11.146 A 0.5,0.5,0,0,0,9.65,11.146 L 4.988,15.726 A 2,2,0,0,0,6,16" />
                    </Viewbox>
                    <TextBlock x:Name="EmptyStateTitle"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.AutomationId="EmptyStateTitle" />
                    <TextBlock x:Name="EmptyStateHint"
                               MaxWidth="360"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="EmptyStateHint" />
                    <Button x:Name="EmptyOpenButton"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="EmptyOpenButton"
                            Click="OpenButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Command layer. The official CommandBar owns the surface, button
                 metrics, overflow behavior and keyboard handling. It is docked
                 to the top of the content area, so the acrylic surface runs
                 edge to edge and the canvas keeps its full height. -->
            <CommandBar x:Name="ViewerCommandBar"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True">
                <CommandBar.Resources>
                    <Style TargetType="AppBarButton"
                           BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                        <Setter Property="Width" Value="{ThemeResource AppBarThemeCompactHeight}" />
                    </Style>
                    <Style TargetType="AppBarToggleButton"
                           BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                        <Setter Property="Width" Value="{ThemeResource AppBarThemeCompactHeight}" />
                    </Style>
                </CommandBar.Resources>
                <CommandBar.Content>
                    <!-- Status belongs to the command layer. The filename and
                         view state sit in the command bar content area instead
                         of a second bar along the bottom edge. The bar sizes
                         its content to the text, so this row takes the bar's
                         own height and centers both lines in it. -->
                    <Grid Padding="12,0"
                          ColumnSpacing="16"
                          VerticalAlignment="Center"
                          MinHeight="{Binding ActualHeight, ElementName=ViewerCommandBar}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileStatusText"
                                   AutomationProperties.AutomationId="FileStatus"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Text=""
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ViewStatusText"
                                   Grid.Column="1"
                                   AutomationProperties.AutomationId="ViewStatus"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="" />
                    </Grid>
                </CommandBar.Content>
                <CommandBar.PrimaryCommands>
                        <AppBarButton x:Name="OpenButton"
                                      AutomationProperties.AutomationId="OpenButton"
                                      Click="OpenButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE838;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="O" Modifiers="Control" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton x:Name="PreviousButton"
                                      AutomationProperties.AutomationId="PreviousButton"
                                      IsEnabled="False"
                                      Click="PreviousButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE76B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="NextButton"
                                      AutomationProperties.AutomationId="NextButton"
                                      IsEnabled="False"
                                      Click="NextButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE76C;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarToggleButton x:Name="PlayPauseButton"
                                            Visibility="Collapsed"
                                            AutomationProperties.AutomationId="PlayPauseButton"
                                            Click="PlayPauseButton_Click">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE768;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarToggleButton x:Name="LoopButton"
                                            Visibility="Collapsed"
                                            AutomationProperties.AutomationId="LoopButton"
                                            Click="LoopButton_Click">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8EE;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarButton x:Name="ZoomOutButton"
                                      AutomationProperties.AutomationId="ZoomOutButton"
                                      IsEnabled="False"
                                      Click="ZoomOutButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE71F;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="ZoomInButton"
                                      AutomationProperties.AutomationId="ZoomInButton"
                                      IsEnabled="False"
                                      Click="ZoomInButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8A3;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton x:Name="RotateButton"
                                      AutomationProperties.AutomationId="RotateButton"
                                      IsEnabled="False"
                                      Click="RotateButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7AD;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="FitButton"
                                      AutomationProperties.AutomationId="FitButton"
                                      IsEnabled="False"
                                      Click="FitButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE9A6;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="ActualSizeButton"
                                      AutomationProperties.AutomationId="ActualSizeButton"
                                      IsEnabled="False"
                                      Click="ActualSizeButton_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="1:1" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                    </CommandBar.PrimaryCommands>

                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Name="CopyImageCommand"
                                      AutomationProperties.AutomationId="CopyImageMenuItem"
                                      IsEnabled="False"
                                      KeyboardAcceleratorTextOverride="Ctrl+C"
                                      KeyboardAcceleratorPlacementMode="Auto"
                                      Click="CopyImageMenuItem_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="CopyPathCommand"
                                      AutomationProperties.AutomationId="CopyPathMenuItem"
                                      IsEnabled="False"
                                      KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                                      KeyboardAcceleratorPlacementMode="Auto"
                                      Click="CopyPathMenuItem_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE71B;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="SaveAsCommand"
                                      AutomationProperties.AutomationId="SaveAsMenuItem"
                                      IsEnabled="False"
                                      KeyboardAcceleratorTextOverride="Ctrl+S"
                                      KeyboardAcceleratorPlacementMode="Auto"
                                      Click="SaveAsMenuItem_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74E;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton x:Name="ShowInExplorerCommand"
                                      AutomationProperties.AutomationId="ShowInExplorerMenuItem"
                                      IsEnabled="False"
                                      Click="ShowInExplorerMenuItem_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8DA;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
            </CommandBar>
                </Grid>

                <!-- Settings and About are peers of the viewer, so each gets
                     its own full-window host instead of a nested back stack. -->
                <ContentControl x:Name="SettingsHost"
                                Visibility="Collapsed"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <ContentControl x:Name="AboutHost"
                                Visibility="Collapsed"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
