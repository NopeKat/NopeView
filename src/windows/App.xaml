<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NopeView.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared settings layout. Values follow the WinUI Gallery
                 settings sample: 36 px page inset, a 1064 px content column,
                 24/8 section spacing and 4 px between cards. -->
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="SettingsContentMaxWidth">1064</x:Double>
            <x:Double x:Key="SettingsPageMaxWidth">1136</x:Double>
            <Thickness x:Key="SettingsContentPadding">36,0,36,0</Thickness>

            <!-- AppBarButton reserves 2,6,2,6 around its hover surface inside
                 the compact 48x48 slot, which makes the visible press area a
                 44x36 rectangle. A uniform 4 inset leaves a 40x40 square. -->
            <Thickness x:Key="AppBarButtonInnerBorderMargin">4</Thickness>
            <Thickness x:Key="AppBarButtonInnerBorderCompactMargin">4</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
