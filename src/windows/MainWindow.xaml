            <!-- Command layer. The official CommandBar owns the surface, button
                 metrics, overflow behavior and keyboard handling. It is docked
                 to the top of the content area, so the acrylic surface runs
                 edge to edge and the canvas keeps its full height. -->
            <CommandBar x:Name="ViewerCommandBar"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True">
                <CommandBar.Resources>
                    <Style TargetType="AppBarButton"
                           BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                        <Setter Property="Width" Value="{ThemeResource AppBarThemeCompactHeight}" />
                    </Style>
                    <Style TargetType="AppBarToggleButton"
