<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <!-- Command shortcuts live on their buttons so Fluent tooltips can show
         them. The clipboard commands are overflow items that WinUI unloads
         while the popup is closed, so their keys stay global here and the
         buttons carry the shortcut text instead. -->
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded"
          KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyImageAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAsAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SettingsSectionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The official TitleBar owns the caption, drag region and system
             buttons. The caption carries the product name; the content area
             next to it carries the document status. Both are plain text, so
             the row still drags the window. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="NopeView"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  IsPaneToggleButtonVisible="False"
                  IsBackButtonVisible="False"
                  AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.Resources>
                <!-- The template centers content it can measure, which would
                     leave the status at its natural width. Stretching gives it
                     the whole row, so a long name trims with an ellipsis. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <!-- Content promotes the bar from the 32 px caption the
                     system draws to the 48 px expanded height, which
                     pushes the icon and title below the caption row. The
                     status is one 16 px line, so the row stays compact. -->
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/nopeview-title.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- The status readouts sit outside the title bar so the pair can be
             centered in the caption. The template scales the caption button
             inset from pixels to DIP, so the group is pinned clear of the
             system buttons from code instead of following the template. -->
        <StackPanel x:Name="CaptionStatus"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24"
                    Margin="0,-1,0,0"
                    IsHitTestVisible="False">
            <TextBlock x:Name="FileStatusText"
                       AutomationProperties.AutomationId="FileStatus"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="" />
            <TextBlock x:Name="ViewStatusText"
                       AutomationProperties.AutomationId="ViewStatus"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="" />
        </StackPanel>

        <!-- The viewer is the only surface in this window: settings and the
             about content live in the settings window, so this window has no
             navigation pane. -->
        <Grid x:Name="ContentRoot"
              Grid.Row="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- The official InfoBar owns the error layout, severity colors,
         icon and text metrics. It sits below the command layer and
         pushes the viewer down instead of covering the image. -->
    <InfoBar x:Name="ErrorPanel"
             Grid.Row="1"
             Severity="Error"
             IsOpen="False"
             IsClosable="True"
             Margin="24,8,24,0"
             AutomationProperties.AutomationId="ErrorInfoBar" />
