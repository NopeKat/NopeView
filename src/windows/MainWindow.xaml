    <!-- Command layer. The official CommandBar owns the surface, button
         metrics, overflow behavior and keyboard handling. It is docked
         to the top of the content area, so the acrylic surface runs
         edge to edge and the canvas keeps its full height. -->
    <CommandBar x:Name="ViewerCommandBar"
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                DefaultLabelPosition="Collapsed"
                IsDynamicOverflowEnabled="True">
        <CommandBar.Resources>
            <Style TargetType="AppBarButton"
                   BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                <Setter Property="Width" Value="{ThemeResource AppBarThemeCompactHeight}" />
            </Style>
            <Style TargetType="AppBarToggleButton"
                   BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
                <Setter Property="Width" Value="{ThemeResource AppBarThemeCompactHeight}" />
            </Style>
        </CommandBar.Resources>
        <CommandBar.Content>
            <!-- Status belongs to the command layer. The filename and
                 view state sit in the command bar content area instead
                 of a second bar along the bottom edge. The bar sizes
                 its content to the text, so this row takes the bar's
                 own height and centers both lines in it. -->
            <Grid Padding="12,0"
                  ColumnSpacing="16"
                  VerticalAlignment="Center"
                  MinHeight="{Binding ActualHeight, ElementName=ViewerCommandBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileStatusText"
                           AutomationProperties.AutomationId="FileStatus"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text=""
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ViewStatusText"
                           Grid.Column="1"
                           AutomationProperties.AutomationId="ViewStatus"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="" />
