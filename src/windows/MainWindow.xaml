<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NopeView.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NopeView">

    <!-- Command shortcuts live on their buttons so Fluent tooltips can show
         them. The clipboard commands are overflow items that WinUI unloads
         while the popup is closed, so their keys stay global here and the
         buttons carry the shortcut text instead. -->
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded"
          KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyImageAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyPathAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAsAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="ViewerSectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SettingsSectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="AboutSectionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The official TitleBar owns the caption, drag region, back slot and
             pane toggle button. The pane button is forwarded to NavigationView
             through PaneToggleRequested, matching the WinUI guidance. -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="NopeView"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested"
                  IsBackButtonVisible="False"
                  AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///assets/nopeview-title.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Top-level destinations share one navigation pane. Compact mode
             keeps the entry points visible as icons while the image still gets
             most of the width. Settings is a command item: it opens its own
             window instead of taking the selection. -->
        <NavigationView x:Name="TopLevelNav"
                        Grid.Row="1"
                        PaneDisplayMode="LeftMinimal"
                        OpenPaneLength="320"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        IsPaneOpen="False"
                        Padding="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        AutomationProperties.AutomationId="TopLevelNav"
                        ItemInvoked="TopLevelNav_ItemInvoked"
                        SelectionChanged="TopLevelNav_SelectionChanged">
