<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NopeView.App.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="AboutPage"
    Background="Transparent">

    <Grid MaxWidth="{StaticResource SettingsPageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="36,24,36,0">
            <TextBlock x:Name="AboutHeader"
                       Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.AutomationId="AboutPageHeader"
                       AutomationProperties.HeadingLevel="Level1" />
        </Grid>
        <ScrollView Grid.Row="1"
                    Padding="{StaticResource SettingsContentPadding}"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
            <StackPanel MaxWidth="{StaticResource SettingsContentMaxWidth}"
                        Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <Grid Margin="0,8,0,16"
                      ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="64"
                           Height="64"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           Source="ms-appx:///assets/nopeview-title.png" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock x:Name="AppNameText"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="DescriptionText"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="VersionText" />
                    </StackPanel>
                </Grid>

                <toolkit:SettingsCard x:Name="RepositoryCard">
                    <toolkit:SettingsCard.HeaderIcon>
                        <PathIcon Data="F1 M8 6C8.27614 6 8.5 6.22386 8.5 6.5C8.5 6.74546 8.32312 6.94961 8.08988 6.99194L8 7H6C4.34315 7 3 8.34315 3 10C3 11.5906 4.23784 12.892 5.80275 12.9936L6 13H8C8.27614 13 8.5 13.2239 8.5 13.5C8.5 13.7455 8.32312 13.9496 8.08988 13.9919L8 14H6C3.79086 14 2 12.2091 2 10C2 7.8645 3.67346 6.11986 5.78053 6.00592L6 6H8ZM14 6C16.2091 6 18 7.79086 18 10C18 12.1355 16.3265 13.8801 14.2195 13.9941L14 14H12C11.7239 14 11.5 13.7761 11.5 13.5C11.5 13.2545 11.6769 13.0504 11.9101 13.0081L12 13H14C15.6569 13 17 11.6569 17 10C17 8.40942 15.7622 7.10795 14.1973 7.00638L14 7H12C11.7239 7 11.5 6.77614 11.5 6.5C11.5 6.25454 11.6769 6.05039 11.9101 6.00806L12 6H14ZM6 9.5H14C14.2761 9.5 14.5 9.72386 14.5 10C14.5 10.2455 14.3231 10.4496 14.0899 10.4919L14 10.5H6C5.72386 10.5 5.5 10.2761 5.5 10C5.5 9.75454 5.67688 9.55039 5.91012 9.50806L6 9.5H14H6Z" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <HyperlinkButton x:Name="RepositoryButton"
                                     Content="NopeKat/NopeView"
                                     NavigateUri="https://github.com/NopeKat/NopeView"
                                     AutomationProperties.AutomationId="RepositoryButton" />
                </toolkit:SettingsCard>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
