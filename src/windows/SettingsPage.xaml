                                    <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                                    <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="SystemColorButtonTextColorBrush" />
                                    <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="SystemColorButtonTextColorBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
