                <TextBlock x:Name="AboutSectionHeader"
                           Style="{StaticResource SettingsSectionHeaderStyle}"
                           AutomationProperties.HeadingLevel="Level2" />

                <!-- 36 px bottom margin on the closing expander follows the WinUI
                     Gallery settings page, where the scroll view reserves its bottom
                     inset on the last block instead of on the ScrollView itself. It
                     keeps the expanded last card clear of the page edge. -->
                <toolkit:SettingsExpander x:Name="AboutExpander"
                                          IsExpanded="False"
                                          Margin="0,0,0,36"
                                          AutomationProperties.AutomationId="AboutExpander">
                    <!-- The toolkit header is a ToggleButton whose fill is swapped
                         with a discrete key frame on hover, press and checked,
                         so the whole card jumps 37 -> 24 -> 37 in one frame over
                         about 50 ms. Aliasing the fill and border keys in this
                         expander's own scope pins every state to the resting
                         colors; the chevron animation is left as the only
                         feedback. -->
                    <toolkit:SettingsExpander.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="SettingsCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
