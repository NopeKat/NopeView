                                    <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                                    <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                                    <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
