                    <ComboBox x:Name="LanguageComboBox"
                              HorizontalAlignment="Right"
                              AutomationProperties.AutomationId="LanguageComboBox"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem x:Name="LanguageSystemOption"
                                      Tag=""
                                      AutomationProperties.AutomationId="LanguageSystem" />
                        <ComboBoxItem x:Name="LanguageChineseOption"
                                      Tag="zh-Hans"
                                      AutomationProperties.AutomationId="LanguageChinese" />
                        <ComboBoxItem x:Name="LanguageEnglishOption"
                                      Tag="en-US"
                                      AutomationProperties.AutomationId="LanguageEnglish" />
                    </ComboBox>
